<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        实验四关键点：parent 必须使用 .Bridge 结尾的 MaterialComponents 主题。
        新版 Android Studio 默认生成的 Theme.Material3.* 会让 Button 自定义 background 失效，
        改为 Theme.MaterialComponents.DayNight.DarkActionBar.Bridge 后按钮背景才会生效。
    -->
    <style name="Base.Theme.Lab4Cardgame" parent="Theme.MaterialComponents.DayNight.DarkActionBar.Bridge">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="actionBarStyle">@style/AppActionBar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.AppActionBar</item>
    </style>

    <style name="Theme.Lab4Cardgame" parent="Base.Theme.Lab4Cardgame" />

    <!-- ActionBar 样式 -->
    <style name="AppActionBar" parent="Widget.AppCompat.ActionBar.Solid">
        <item name="background">@color/primary</item>
        <item name="titleTextStyle">@style/AppActionBar.Title</item>
        <item name="elevation">4dp</item>
    </style>

    <style name="AppActionBar.Title" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="ThemeOverlay.AppActionBar" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="colorControlNormal">@color/white</item>
    </style>

    <!-- 页面通用文字样式 -->
    <style name="Text.Info" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="Text.SectionTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Label" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- 主按钮（实心） -->
    <style name="Widget.App.Button.Primary" parent="Widget.AppCompat.Button">
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- 次级按钮（描边） -->
    <style name="Widget.App.Button.Outline" parent="Widget.AppCompat.Button">
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_btn_outline</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
