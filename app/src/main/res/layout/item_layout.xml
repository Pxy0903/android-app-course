<?xml version="1.0" encoding="utf-8"?>
<!--
    RecyclerView 的单个牌面格子（View 层）。
    外层 MaterialCardView 负责圆角、阴影和间距；内部叠放"牌背图片"和"牌面文字"，
    由 CardAdapter 根据牌的状态切换显示哪一个。
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="3dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivCardBack"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/card_back_desc"
            android:scaleType="centerCrop"
            android:src="@drawable/card_back" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvCardFace"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/card_face"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            app:autoSizeMaxTextSize="26sp"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
